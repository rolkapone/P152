{
  "$description": "P152 design tokens v0.4 (direction Natif, Premium, Precis). Miroir de tokens.css (le CSS est la source consommee par l'app). Format : DTCG simplifie.",
  "font": {
    "sans": "Inter, system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "ui-monospace, 'Cascadia Mono', Consolas, Menlo, monospace",
    "file": "public/fonts/inter-latin-wght-normal.woff2 (Inter variable, latin, SIL OFL 1.1, auto-heberge)",
    "features": { "default": "'kern', 'calt', 'ss03'", "alt": "'kern', 'calt', 'ss03', 'cv11', 'ss01'" },
    "size": { "sm": "14px", "md": "16px", "lg": "17px", "xl": "22px", "2xl": "28px", "3xl": "34px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "leading": { "tight": 1.2, "snug": 1.3, "normal": 1.45 },
    "style": {
      "large-title": { "font": "700 34px/1.2", "tracking": "-0.022em" },
      "title-1": { "font": "700 28px/1.21", "tracking": "-0.021em" },
      "title-2": { "font": "600 22px/1.27", "tracking": "-0.018em" },
      "title-3": { "font": "600 20px/1.25", "tracking": "-0.017em" },
      "headline": { "font": "600 16px/1.375", "tracking": "-0.011em" },
      "body": { "font": "400 16px/1.375", "tracking": "-0.011em" },
      "callout": { "font": "400 15px/1.33", "tracking": "-0.009em" },
      "subheadline": { "font": "400 14px/1.36", "tracking": "-0.006em" },
      "footnote": { "font": "400 14px/1.29", "tracking": "-0.006em" },
      "caption": { "font": "500 14px/1.29", "tracking": "0em" }
    },
    "tracking": { "tight": "-0.018em", "overline": "0.04em", "formula": "-0.0223 + 0.185 * e^(-0.1745 * px)" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "panel-pad": "16px", "float-inset": "12px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "xl": "22px", "pill": "999px", "rule": "interne = externe - marge (22-8=14, 14-4=10, 10-4=6)" },
  "control": { "sm": "32px", "md": "36px", "lg": "44px" },
  "icon": { "sm": "16px", "md": "18px", "lg": "20px", "xl": "24px", "stroke": 1.6 },
  "layout": { "topbar": "52px", "panel-left": "248px", "panel-right": "312px", "drawer-max-w": "360px", "popover-w": "320px", "sheet-w": "480px", "toggle-size": "40px", "row-min-h": "56px", "thumb-w": "56px", "thumb-h": "44px", "z-skip": 60 },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms", "spring": "460ms", "camera": "480ms", "reducedMotion": "0ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "linear(0, 0.081 5%, 0.258 10%, 0.46 15%, 0.644 20%, 0.793 25%, 0.901 30%, 0.972 35%, 1.014 40%, 1.033 45%, 1.038 50%, 1.035 55%, 1.029 60%, 1.021 65%, 1.014 70%, 1.008 75%, 1.004 80%, 1)  [repli : cubic-bezier(0.34, 1.3, 0.64, 1)]",
      "spring-soft": "linear(0, 0.09 5%, 0.264 10%, 0.442 15%, 0.594 20%, 0.713 25%, 0.801 30%, 0.908 40%, 0.96 50%, 0.983 60%, 0.993 70%, 0.997 80%, 1)  [repli : cubic-bezier(0.22, 1, 0.36, 1)]"
    },
    "press-scale": 0.97
  },
  "material": {
    "filter": { "ultra-thin": "blur(16px) saturate(160%)", "thin": "blur(20px) saturate(170%)", "regular": "blur(28px) saturate(180%)", "thick": "blur(36px) saturate(180%)", "scrim": "blur(12px) saturate(140%)" },
    "tint": {
      "light": { "ultra-thin": "rgba(246,246,248,0.55)", "thin": "rgba(246,246,248,0.72)", "regular": "rgba(246,246,248,0.80)", "thick": "rgba(248,248,250,0.90)", "solid": "#F2F2F7", "solid-raised": "#FFFFFF" },
      "dark": { "ultra-thin": "rgba(30,30,33,0.55)", "thin": "rgba(30,30,33,0.72)", "regular": "rgba(30,30,33,0.80)", "thick": "rgba(28,28,30,0.90)", "solid": "#1C1C1E", "solid-raised": "#262628" }
    },
    "hairline": { "light": "rgba(255,255,255,0.60)", "dark": "rgba(255,255,255,0.14)" },
    "outline": { "light": "rgba(0,0,0,0.10)", "dark": "rgba(0,0,0,0.60)" },
    "use": {
      "ultra-thin": "glyphes seuls (>= 3:1)",
      "thin": "texte principal + icones (barre de vue)",
      "regular": "tout texte (barre d'outils, barre laterale, inspecteur, astuce)",
      "thick": "menus, popovers, feuilles, toasts"
    },
    "fallback": "fond opaque material-solid (thick : solid-raised), sans flou, si @supports echoue OU prefers-reduced-transparency: reduce OU classe .no-glass",
    "link": { "light": "#0A46B8", "dark": "#A8C8FF" },
    "alias": "--glass-tint/-border/-shadow/-filter/-blur/-saturate/-link et la classe .glass = materiau regular (noms historiques conserves)"
  },
  "color": {
    "light": {
      "bg": "#F2F2F7", "surface": "#FFFFFF", "surface-2": "#EBEBF0", "raised": "#FFFFFF", "border": "#D8D8DE", "separator": "rgba(60,60,67,0.16)", "border-strong": "#86868E", "fill": "rgba(118,118,128,0.14)", "fill-hover": "rgba(118,118,128,0.10)", "overlay": "rgba(0,0,0,0.32)",
      "text": "#1C1C1E", "text-muted": "#4C4C54", "text-disabled": "#9A9AA2",
      "accent": "#0A64E8", "accent-hover": "#0553C4", "accent-active": "#0443A3", "on-accent": "#FFFFFF",
      "accent-solid": "#0A64E8", "accent-solid-hover": "#0553C4", "accent-solid-active": "#0443A3", "on-accent-solid": "#FFFFFF",
      "accent-subtle": "#DDEAFE", "accent-subtle-text": "#0A46B8", "focus": "#0A52C2", "focus-halo": "rgba(10,82,194,0.28)",
      "success": "#137A3F", "success-bg": "#E3F4EA", "error": "#B42318", "error-bg": "#FDECEA",
      "warning": "#8A4B00", "warning-icon": "#B86E00", "warning-bg": "#FFF3DC", "info": "#0B6B8A", "info-bg": "#E3F3F8",
      "danger-solid": "#B42318", "on-danger": "#FFFFFF"
    },
    "dark": {
      "bg": "#0B0B0D", "surface": "#1C1C1E", "surface-2": "#2C2C2E", "raised": "#48484C", "border": "#38383A", "separator": "rgba(84,84,88,0.55)", "border-strong": "#8E8E98", "fill": "rgba(118,118,128,0.28)", "fill-hover": "rgba(118,118,128,0.18)", "overlay": "rgba(0,0,0,0.55)",
      "text": "#F5F5F7", "text-muted": "#C7C7D0", "text-disabled": "#6E6E76",
      "accent": "#5AA0FF", "accent-hover": "#7DB4FF", "accent-active": "#9BC4FF", "on-accent": "#0B1220",
      "accent-solid": "#0A6CF0", "accent-solid-hover": "#0F66DC", "accent-solid-active": "#0B58BE", "on-accent-solid": "#FFFFFF",
      "accent-subtle": "#17335E", "accent-subtle-text": "#B3D1FF", "focus": "#7DB4FF", "focus-halo": "rgba(125,180,255,0.30)",
      "success": "#4CC38A", "success-bg": "#12301F", "error": "#FF8A80", "error-bg": "#3A1714",
      "warning": "#F2B04A", "warning-icon": "#F2B04A", "warning-bg": "#33260D", "info": "#5CC4E0", "info-bg": "#0F2A33",
      "danger-solid": "#C4302B", "on-danger": "#FFFFFF"
    }
  },
  "scene": {
    "note": "Inchange par rapport a v0.3 hors selection. Studio clair (photo produit) en theme clair ; contour de selection a 2 tons (blanc + sombre) lisible sur tout fond.",
    "light": { "bg-top": "#FAFAFC", "bg-bottom": "#DFE2E8", "floor": "#EEF0F3", "shadow": "rgba(40,48,64,0.28)", "desk": "#D9CBB2", "object": "#8E97A6", "selection": "#0A64E8", "error": "#B42318", "warning": "#B86E00" },
    "dark":  { "bg-top": "#3A414D", "bg-bottom": "#12161C", "floor": "#1C2129", "shadow": "rgba(0,0,0,0.5)", "desk": "#8C7B62", "object": "#8E97A6", "selection": "#7DB4FF", "error": "#FF8A80", "warning": "#F2B04A" }
  },
  "shadow": {
    "light": {
      "1": "0 0 0 0.5px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.04), 0 2px 8px rgba(0,0,0,.04)",
      "2": "0 0 0 0.5px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.10)",
      "3": "0 0 0 0.5px rgba(0,0,0,.08), 0 8px 24px rgba(0,0,0,.08), 0 32px 80px rgba(0,0,0,.16)",
      "glass": "inset 0 0 0 1px rgba(255,255,255,.60), 0 0 0 0.5px rgba(0,0,0,.10), 0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.08), 0 24px 56px rgba(0,0,0,.10)"
    },
    "dark": {
      "1": "0 0 0 0.5px rgba(255,255,255,.06), 0 1px 2px rgba(0,0,0,.30), 0 2px 8px rgba(0,0,0,.25)",
      "2": "0 0 0 0.5px rgba(255,255,255,.08), 0 4px 12px rgba(0,0,0,.35), 0 12px 32px rgba(0,0,0,.40)",
      "3": "0 0 0 0.5px rgba(255,255,255,.10), 0 8px 24px rgba(0,0,0,.40), 0 32px 80px rgba(0,0,0,.55)",
      "glass": "inset 0 0 0 1px rgba(255,255,255,.14), 0 0 0 0.5px rgba(0,0,0,.60), 0 1px 2px rgba(0,0,0,.30), 0 8px 24px rgba(0,0,0,.35), 0 24px 56px rgba(0,0,0,.45)"
    }
  },
  "focus": { "width": "3px", "offset": "2px", "halo": "0 0 0 8px color.focus-halo (offset 2 + width 3 + 3)" }
}
