{
  "$description": "P152 design tokens v0.2. Miroir de tokens.css (CSS = source consommee par l'app). Format : DTCG simplifie.",
  "font": {
    "sans": "Inter, system-ui, 'Segoe UI', Roboto, Arial, sans-serif",
    "mono": "ui-monospace, 'Cascadia Mono', Consolas, monospace",
    "file": "public/fonts/inter-latin-wght-normal.woff2 (Inter variable, latin, SIL OFL 1.1, auto-heberge)",
    "size": { "sm": "14px", "md": "16px", "lg": "18px", "xl": "22px", "2xl": "28px", "3xl": "36px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "leading": { "tight": 1.2, "normal": 1.5 },
    "tracking": { "tight": "-0.011em", "overline": "0.06em" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "panel-pad": "20px", "float-inset": "12px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px", "pill": "999px" },
  "control": { "sm": "32px", "md": "36px", "lg": "44px" },
  "layout": { "topbar": "56px", "panel-left": "248px", "panel-right": "312px", "drawer-max-w": "360px", "toggle-size": "40px", "row-min-h": "56px", "thumb-w": "56px", "thumb-h": "44px", "z-skip": 60 },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms", "camera": "480ms", "reducedMotion": "0ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "cubic-bezier(0.34, 1.3, 0.64, 1)"
    },
    "press-scale": 0.97
  },
  "glass": {
    "blur": "24px",
    "saturate": "180%",
    "blur-soft": "12px",
    "tint": { "light": "rgba(255,255,255,0.86)", "dark": "rgba(28,32,40,0.86)" },
    "border": { "light": "rgba(255,255,255,0.65)", "dark": "rgba(255,255,255,0.14)" },
    "link": { "light": "#1A4FB0", "dark": "#8AB2FF" },
    "fallback": "background = color.surface, backdrop-filter none (si @supports echoue OU prefers-reduced-transparency: reduce)",
    "min-tint-alpha": 0.86
  },
  "color": {
    "light": {
      "bg": "#F3F4F7", "surface": "#FFFFFF", "surface-2": "#EEF0F4", "border": "#DDE0E7", "border-strong": "#7A8394", "overlay": "rgba(16,20,28,0.42)",
      "text": "#1B1F27", "text-muted": "#545D6C", "text-disabled": "#8B93A1",
      "accent": "#1F5FD1", "accent-hover": "#1A4FB0", "accent-active": "#153F8F", "on-accent": "#FFFFFF", "accent-subtle": "#E6EEFB", "accent-subtle-text": "#1A4FB0", "focus": "#1F5FD1",
      "success": "#137A3F", "success-bg": "#E3F4EA", "error": "#B42318", "error-bg": "#FDECEA",
      "warning": "#8A4B00", "warning-icon": "#B86E00", "warning-bg": "#FFF3DC", "info": "#0B6B8A", "info-bg": "#E3F3F8",
      "danger-solid": "#B42318"
    },
    "dark": {
      "bg": "#0E1115", "surface": "#171B22", "surface-2": "#212630", "border": "#2C323D", "border-strong": "#7D8798", "overlay": "rgba(0,0,0,0.55)",
      "text": "#E8EBF0", "text-muted": "#A3ACBA", "text-disabled": "#6B7482",
      "accent": "#6C9CFF", "accent-hover": "#8AB2FF", "accent-active": "#A6C4FF", "on-accent": "#0B1220", "accent-subtle": "#18284A", "accent-subtle-text": "#A6C4FF", "focus": "#8AB2FF",
      "success": "#4CC38A", "success-bg": "#12301F", "error": "#FF8A80", "error-bg": "#3A1714",
      "warning": "#F2B04A", "warning-icon": "#F2B04A", "warning-bg": "#33260D", "info": "#5CC4E0", "info-bg": "#0F2A33",
      "danger-solid": "#C4302B"
    }
  },
  "scene": {
    "note": "Studio clair (photo produit) en theme clair ; contour de selection a 2 tons (blanc + sombre) lisible sur tout fond.",
    "light": { "bg-top": "#FAFAFC", "bg-bottom": "#DFE2E8", "floor": "#EEF0F3", "shadow": "rgba(40,48,64,0.28)", "desk": "#D9CBB2", "object": "#8E97A6", "selection": "#1F5FD1", "error": "#B42318", "warning": "#B86E00" },
    "dark":  { "bg-top": "#3A414D", "bg-bottom": "#12161C", "floor": "#1C2129", "shadow": "rgba(0,0,0,0.5)", "desk": "#8C7B62", "object": "#8E97A6", "selection": "#8AB2FF", "error": "#FF8A80", "warning": "#F2B04A" }
  },
  "shadow": {
    "light": {
      "1": "0 1px 1px rgba(16,20,28,.04), 0 2px 4px rgba(16,20,28,.04), 0 4px 12px rgba(16,20,28,.05)",
      "2": "0 0 0 1px rgba(16,20,28,.04), 0 2px 4px rgba(16,20,28,.05), 0 8px 16px rgba(16,20,28,.07), 0 16px 32px rgba(16,20,28,.07)",
      "3": "0 0 0 1px rgba(16,20,28,.05), 0 4px 8px rgba(16,20,28,.06), 0 16px 32px rgba(16,20,28,.10), 0 40px 80px rgba(16,20,28,.14)",
      "glass": "0 0 0 1px rgba(16,20,28,.05), 0 2px 4px rgba(16,20,28,.05), 0 8px 16px rgba(16,20,28,.08), 0 24px 48px rgba(16,20,28,.12), inset 0 1px 0 rgba(255,255,255,.7)"
    },
    "dark": {
      "1": "0 1px 1px rgba(0,0,0,.30), 0 2px 4px rgba(0,0,0,.25), 0 0 0 1px rgba(255,255,255,.04)",
      "2": "0 0 0 1px rgba(255,255,255,.06), 0 2px 4px rgba(0,0,0,.30), 0 8px 16px rgba(0,0,0,.35), 0 16px 32px rgba(0,0,0,.35)",
      "3": "0 0 0 1px rgba(255,255,255,.08), 0 4px 8px rgba(0,0,0,.35), 0 16px 32px rgba(0,0,0,.45), 0 40px 80px rgba(0,0,0,.5)",
      "glass": "0 0 0 1px rgba(255,255,255,.06), 0 2px 4px rgba(0,0,0,.30), 0 8px 16px rgba(0,0,0,.35), 0 24px 48px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.08)"
    }
  },
  "focus": { "width": "3px", "offset": "2px" }
}
